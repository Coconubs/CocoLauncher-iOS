diff --git a/MobileGlues-cpp/config/settings.cpp b/MobileGlues-cpp/config/settings.cpp
index 43d5dd0..60c7633 100644
--- a/MobileGlues-cpp/config/settings.cpp
+++ b/MobileGlues-cpp/config/settings.cpp
@@ -33,6 +33,39 @@ void init_settings() {
     global_settings.fsr1_setting = FSR1_Quality_Preset::Disabled;
     global_settings.hide_mg_env_level = HideMGEnvLevel::Disabled;
 
+    // CocoLauncher: the defaults above stay, but every key present in MG_DIR_PATH/config.json
+    // (written by the launcher's advanced graphics settings) overrides its default.
+    // No file or a missing key keeps the behaviour of upstream MobileGlues on Apple.
+    // Loading the config here also lets parse_multidraw_orders() read "multidrawOrder".
+    if (initialized || config_refresh()) {
+        int v = config_get_int("enableNoError");
+        if (v == static_cast<int>(NoErrorConfig::Disable)) {
+            global_settings.ignore_error = IgnoreErrorLevel::None;
+        } else if (v == static_cast<int>(NoErrorConfig::Level1)) {
+            global_settings.ignore_error = IgnoreErrorLevel::Partial;
+        } else if (v == static_cast<int>(NoErrorConfig::Level2)) {
+            global_settings.ignore_error = IgnoreErrorLevel::Full;
+        }
+        v = config_get_int("enableExtComputeShader");
+        if (v >= 0) global_settings.ext_compute_shader = v > 0;
+        v = config_get_int("enableExtTimerQuery");
+        if (v >= 0) global_settings.ext_timer_query = v > 0;
+        v = config_get_int("enableExtDirectStateAccess");
+        if (v >= 0) global_settings.ext_direct_state_access = v > 0;
+        v = config_get_int("maxGlslCacheSize");
+        if (v >= 0 && v <= 1024) global_settings.max_glsl_cache_size = static_cast<size_t>(v) * 1024 * 1024;
+        v = config_get_int("angleDepthClearFixMode");
+        if (v >= 0 && v < static_cast<int>(AngleDepthClearFixMode::MaxValue)) {
+            global_settings.angle_depth_clear_fix_mode = static_cast<AngleDepthClearFixMode>(v);
+        }
+        v = config_get_int("customGLVersion");
+        if (v == 32 || v == 33 || (v >= 40 && v <= 46)) global_settings.custom_gl_version = Version(v);
+        v = config_get_int("fsr1Setting");
+        if (v >= 0 && v < static_cast<int>(FSR1_Quality_Preset::MaxValue)) {
+            global_settings.fsr1_setting = static_cast<FSR1_Quality_Preset>(v);
+        }
+    }
+
 #else
 
     int success = initialized;
diff --git a/MobileGlues-cpp/egl/trace.h b/MobileGlues-cpp/egl/trace.h
index 61cf26f..f97adb2 100644
--- a/MobileGlues-cpp/egl/trace.h
+++ b/MobileGlues-cpp/egl/trace.h
@@ -12,6 +12,8 @@
 #include <EGL/egl.h>
 #include <sys/syscall.h>
 #include <unistd.h>
+#include <pthread.h>
+#include <stdint.h>
 
 // Tracing for the EGL layer.
 //
@@ -35,7 +37,14 @@
 // A thread id, via the syscall rather than gettid(), which bionic only exposes as
 // a real symbol from API 30 and this library targets 21.
 static inline int mg_egl_tid(void) {
+#if defined(__APPLE__)
+    // CocoLauncher: no gettid syscall on Darwin
+    uint64_t tid = 0;
+    pthread_threadid_np(NULL, &tid);
+    return (int)tid;
+#else
     return (int)syscall(__NR_gettid);
+#endif
 }
 
